#include <iostream>
using namespace std;

struct Task
{
    int id;
    string name;
    int status;
};

int main()
{
    Task t[15];
    int n = 0, id = 1, choice, x;

    do
    {
        cout << "\n To-Do List \n";
        cout << "1. Add Task\n";
        cout << "2. Mark Completed\n";
        cout << "3. View Pending\n";
        cout << "4. View Completed\n";
        cout << "5. Delete Task\n";
        cout << "6. Exit\n";
        cout << "Enter choice: ";
        cin >> choice;

        switch(choice)
        {
            case 1:
                if(n < 15)
                {
                    t[n].id = id;

                    cout << "Enter task: ";
                    cin.ignore();
                    getline(cin, t[n].name);

                    t[n].status = 0;

                    cout << "Task added with ID " << id << endl;

                    n++;
                    id++;
                }
                else
                    cout << "List is full\n";
                break;

            case 2:
                cout << "Enter task ID: ";
                cin >> x;

                for(int i = 0; i < n; i++)
                {
                    if(t[i].id == x)
                    {
                        if(t[i].status == 1)
                            cout << "Task is already completed\n";
                        else
                        {
                            t[i].status = 1;
                            cout << "Task marked as completed\n";
                        }
                        break;
                    }
                }
                break;

            case 3:
                for(int i = 0; i < n; i++)
                {
                    if(t[i].status == 0)
                        cout << "[" << t[i].id << "] " << t[i].name << endl;
                }
                break;

            case 4:
                for(int i = 0; i < n; i++)
                {
                    if(t[i].status == 1)
                        cout << "[" << t[i].id << "] " << t[i].name << endl;
                }
                break;

            case 5:
                cout << "Enter task ID: ";
                cin >> x;

                for(int i = 0; i < n; i++)
                {
                    if(t[i].id == x)
                    {
                        for(int j = i; j < n - 1; j++)
                            t[j] = t[j + 1];

                        n--;
                        cout << "Task deleted\n";
                        break;
                    }
                }
                break;

            case 6:
                cout << "Exiting...\n";
                break;

            default:
                cout << "Invalid choice\n";
        }

    } while(choice != 6);

    return 0;
}
