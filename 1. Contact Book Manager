#include <iostream>
using namespace std;

struct Contact
{
    string name;
    string phone;
};

int main()
{
    Contact c[20];
    int n = 0, choice;

    do
    {
        cout << "\n1. Add Contact";
        cout << "\n2. View Contacts";
        cout << "\n3. Search Contact";
        cout << "\n4. Delete Contact";
        cout << "\n5. Exit";
        cout << "\nEnter choice: ";
        cin >> choice;

        switch(choice)
        {
            case 1:
                if(n == 20)
                {
                    cout << "Contact book is full";
                }
                else
                {
                    cout << "Enter name: ";
                    cin >> c[n].name;

                    cout << "Enter phone: ";
                    cin >> c[n].phone;

                    if(c[n].phone.length() == 10)
                    {
                        n++;
                        cout << "Contact added";
                    }
                    else
                    {
                        cout << "Invalid phone number";
                    }
                }
                break;

            case 2:
                for(int i = 0; i < n; i++)
                {
                    cout << "\nName: " << c[i].name;
                    cout << "\nPhone: " << c[i].phone << endl;
                }
                break;

            case 3:
            {
                string name;
                bool found = false;

                cout << "Enter name: ";
                cin >> name;

                for(int i = 0; i < n; i++)
                {
                    if(c[i].name == name)
                    {
                        cout << "Phone: " << c[i].phone;
                        found = true;
                    }
                }

                if(found == false)
                    cout << "Contact not found";

                break;
            }

            case 4:
            {
                string name;
                cout << "Enter name: ";
                cin >> name;

                for(int i = 0; i < n; i++)
                {
                    if(c[i].name == name)
                    {
                        for(int j = i; j < n - 1; j++)
                            c[j] = c[j + 1];

                        n--;
                        cout << "Contact deleted";
                        break;
                    }
                }
                break;
            }

            case 5:
                cout << "Exit";
                break;

            default:
                cout << "Invalid choice";
        }

    } while(choice != 5);

    return 0;
}
